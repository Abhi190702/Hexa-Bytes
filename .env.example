# =============================================================================
# Urban Environmental Stress Mapping Platform — environment template
# Copy to `.env` (root, consumed by docker compose) and fill real values.
# Never commit the real `.env`.
# =============================================================================

# --- PostgreSQL / TimescaleDB / PostGIS ---
POSTGRES_USER=urban
POSTGRES_PASSWORD=changeme
POSTGRES_DB=urban_stress
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- MQTT broker (provisioned in compose; consumer wired in Phase 2) ---
MQTT_HOST=mqtt
MQTT_PORT=1883

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development
API_LOG_LEVEL=INFO
# Comma-separated list of allowed CORS origins
API_CORS_ORIGINS=http://localhost:3000
# Opt in locally if the API should populate/refresh cells after startup.
INGEST_ON_STARTUP=false
INGEST_MAX_AGE_MINUTES=360

# --- External data providers (Phase 4) ---
# Free token from https://aqicn.org/data-platform/token/ (real Delhi AQI stations)
WAQI_TOKEN=

# --- Web (Next.js). Only NEXT_PUBLIC_* are exposed to the browser. ---
# In docker the browser talks to nginx; in local dev it talks to the API directly.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
# MapLibre style URL. OpenFreeMap = free, no API key, full OSM street-level detail.
# Swap for a self-hosted/provider style (MapTiler, Protomaps, etc.) in production.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Default map view — Delhi NCR
NEXT_PUBLIC_MAP_DEFAULT_LON=77.209
NEXT_PUBLIC_MAP_DEFAULT_LAT=28.6139
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=10
